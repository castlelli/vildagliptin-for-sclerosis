---
import '../styles/global.css';
import '../styles/page.css';
import type { Dict } from '../i18n/en';
interface Props { t: Dict }
const { t } = Astro.props;
const base = import.meta.env.BASE_URL;
const here = new URL(Astro.url.pathname, Astro.site);
const enUrl = new URL(base, Astro.site).href;
const ptUrl = new URL(`${base}pt/`, Astro.site).href;
const otherHref = t.lang === 'en' ? `${base}pt/` : base;
const ogImage = new URL(`${base}og.png`, Astro.site).href;
---
<!doctype html>
<html lang={t.lang === 'en' ? 'en' : 'pt-BR'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    <link rel="canonical" href={here.href} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="pt-BR" href={ptUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta name="theme-color" content="#f4f2ec" />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    {t.lang === 'en' && (
      <script is:inline define:vars={{ pt: `${base}pt/` }}>
        try {
          if (!sessionStorage.getItem('lang-chosen') && /^pt\b/i.test(navigator.language || '') && !document.referrer.includes(location.host)) {
            location.replace(pt);
          }
        } catch (e) {}
      </script>
    )}
  </head>
  <body>
    <a class="skip" href="#main">{t.ui.skip}</a>
    <header class="topbar">
      <a class="mark" href={base} aria-label={t.meta.title}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12c3-6 6-6 9 0s6 6 9 0" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="2.4" fill="var(--tracer)"/></svg>
        <span>Vildagliptin <i>×</i> SSc</span>
      </a>
      <nav aria-label="Sections">
        {t.ui.nav.map(([href, label]) => <a href={href}>{label}</a>)}
      </nav>
      <a class="lang" href={otherHref} hreflang={t.lang === 'en' ? 'pt-BR' : 'en'} lang={t.lang === 'en' ? 'pt-BR' : 'en'} data-lang-switch title={t.ui.other.name}>
        <span aria-hidden="true">{t.lang === 'en' ? 'EN' : 'PT'}</span><span class="sep" aria-hidden="true">/</span><b>{t.ui.other.label}</b>
        <span class="vh">{t.ui.other.name}</span>
      </a>
    </header>
    <main id="main">
      <slot />
    </main>
    <script>
      document.querySelectorAll('[data-lang-switch]').forEach((a) =>
        a.addEventListener('click', () => { try { sessionStorage.setItem('lang-chosen', '1'); } catch {} }),
      );
    </script>
  </body>
</html>
